{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/la-asociacion",
      "destination": "/la-asociacion.html",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/la-asociacion.html",
      "permanent": true
    },
    {
      "source": "/manifiesto-del-juicio-final",
      "destination": "/la-asociacion.html",
      "permanent": true
    },
    {
      "source": "/caso-kote-cabezudo",
      "destination": "/caso-kote-cabezudo.html",
      "permanent": true
    },
    {
      "source": "/sumario-684-2013-causa-principal",
      "destination": "/caso-kote-cabezudo.html",
      "permanent": true
    },
    {
      "source": "/las-causas",
      "destination": "/causas.html",
      "permanent": true
    },
    {
      "source": "/nuestros-logros",
      "destination": "/causas.html",
      "permanent": true
    },
    {
      "source": "/infancia",
      "destination": "/causas.html",
      "permanent": true
    },
    {
      "source": "/poetas-de-la-justicia",
      "destination": "/poetas-guerreros.html",
      "permanent": true
    },
    {
      "source": "/poetas-de-la-justicia-3",
      "destination": "/poetas-guerreros.html",
      "permanent": true
    },
    {
      "source": "/contribuye-colabora",
      "destination": "/poetas-guerreros.html",
      "permanent": true
    },
    {
      "source": "/donation-confirmation",
      "destination": "/gracias.html",
      "permanent": true
    },
    {
      "source": "/las-cuentas",
      "destination": "/transparencia.html",
      "permanent": true
    },
    {
      "source": "/financiacion",
      "destination": "/transparencia.html",
      "permanent": true
    },
    {
      "source": "/funcionamiento",
      "destination": "/transparencia.html",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contacto.html",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/necesito-ayuda.html",
      "permanent": true
    },
    {
      "source": "/politica-de-cookies",
      "destination": "/cookies.html",
      "permanent": true
    },
    {
      "source": "/mas-informacion-sobre-las-cookies",
      "destination": "/cookies.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://donate.stripe.com https://buy.stripe.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/solicitud-ayuda.js": {
      "maxDuration": 15
    },
    "api/stripe-webhook.js": {
      "maxDuration": 30
    },
    "api/carnet.js": {
      "maxDuration": 15
    }
  }
}